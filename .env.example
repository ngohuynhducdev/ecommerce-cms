HOST=0.0.0.0
PORT=1337

# Secrets — generate each with: openssl rand -base64 32
APP_KEYS="key1,key2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — SQLite in dev (default), PostgreSQL in production
# Local dev needs nothing here. For prod (e.g. Neon), set:
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://user:pass@host/db
DATABASE_SSL=true

# Media uploads — Cloudinary in production so images survive redeploys.
# Leave blank in dev to store uploads on the local disk.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
